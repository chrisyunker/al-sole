          "attributes": {
            "arn": "arn:aws:cloudfront::714285204136:function/alsole-yunker-dev-url-rewrite",
            "code": "function handler(event) {\n    var request = event.request;\n    var uri = request.uri;\n    \n    // Check if the URI is missing a file extension and doesn't end with /\n    if (!uri.includes('.') \u0026\u0026 !uri.endsWith('/')) {\n        request.uri = uri + '/index.html';\n    }\n    // Check if the URI ends with / but not index.html\n    else if (uri.endsWith('/') \u0026\u0026 !uri.endsWith('index.html')) {\n        request.uri = uri + 'index.html';\n    }\n    \n    return request;\n}\n",
            "comment": "URL rewrite function for directory indexing",
            "etag": "ETVPDKIKX0DER",
            "id": "alsole-yunker-dev-url-rewrite",
            "key_value_store_associations": [],
            "live_stage_etag": "ETVPDKIKX0DER",
            "name": "alsole-yunker-dev-url-rewrite",
            "publish": true,
            "runtime": "cloudfront-js-1.0",
            "status": "DEPLOYED"
          },
